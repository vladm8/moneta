{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MONETA transaction import v1",
  "type": "object",
  "required": ["schema", "transactions"],
  "properties": {
    "schema": { "const": "moneta-transactions-v1" },
    "transactions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["date", "description", "amount", "currency", "type"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "description": { "type": "string", "minLength": 1, "maxLength": 160 },
          "amount": {
            "type": "string",
            "description": "Major currency units, e.g. -42.90. Nonzero, up to 100000000.00. Type defines direction.",
            "pattern": "^[+-]?[0-9]+(\\.[0-9]{1,2})?$"
          },
          "currency": { "enum": ["PLN", "EUR", "USD", "UAH", "GBP"] },
          "type": { "enum": ["income", "expense", "refund", "internal"] },
          "category": { "type": "string", "maxLength": 160 },
          "sourceId": {
            "type": "string",
            "maxLength": 160,
            "description": "Stable source-prefixed ID, e.g. bank-account:transaction-id."
          }
        }
      }
    }
  }
}
