# Server-only configuration. Never prefix these values with VITE_.
MONETA_ORIGIN=http://localhost:5173
BANKING_PORT=3001
BANKING_DATABASE=.banking/moneta.sqlite
# Generated by npm run banking:setup. Keep this key with encrypted database backups.
BANKING_ENCRYPTION_KEY=
ENABLE_BANKING_ENVIRONMENT=SANDBOX
ENABLE_BANKING_SANDBOX_APPLICATION_ID=
ENABLE_BANKING_SANDBOX_PRIVATE_KEY_PATH=
ENABLE_BANKING_PRODUCTION_APPLICATION_ID=
ENABLE_BANKING_PRODUCTION_PRIVATE_KEY_PATH=
ENABLE_BANKING_ALLOW_PRODUCTION=false
